<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>goaway_locomotion</name>
  <version>0.0.0</version>
  <description>Go2 locomotion: FSM and RL policies (goaway_locomotion_node, unitree_sdk2, no ROS libraries) and the height map for perceptive policies (height_map_node, ROS)</description>
  <maintainer email="piuslim373@gmail.com">piuslim373</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- unitree_sdk2 is installed in /opt/unitree_robotics by the Dockerfile (no rosdep key) -->
  <depend>boost</depend>
  <depend>yaml-cpp</depend>
  <depend>fmt</depend>
  <depend>eigen</depend>
  <depend>spdlog</depend>
  <!-- height_map_node only -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>visualization_msgs</depend>
  <depend>unitree_go</depend>
  <depend>htxgrrt_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
