<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>goaway_quadruped_controller</name>
  <version>0.0.0</version>
  <description>Go2 ROS front end: cmd_vel mux, quadruped_main_status, Unitree / HTX locomotion switching</description>
  <maintainer email="piuslim373@gmail.com">piuslim373</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>unitree_go</depend>
  <depend>unitree_api</depend>
  <depend>goaway_msgs</depend>
  <!-- assisted_teleop goal for the UI's safety teleop -->
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
