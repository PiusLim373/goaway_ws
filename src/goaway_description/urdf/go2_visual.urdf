<?xml version="1.0"?>
<!-- Display-only copy of go2.urdf for Lichtblick. Mesh paths are relative to this file, so
     Lichtblick fetches them from wherever it loaded it; package:// would need the rosbridge
     player to fetch assets, which it cannot. Regenerate if go2.urdf changes. -->
<robot name="go2">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0" />
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 0.0" />
  </material>
  <material name="silver">
    <color rgba="0.9137254901960784 0.9137254901960784 0.8470588235294118 1.0" />
  </material>
  <material name="orange">
    <color rgba="1.0 0.4235294117647059 0.0392156862745098 1.0" />
  </material>
  <material name="brown">
    <color rgba="0.8705882352941177 0.8117647058823529 0.7647058823529411 1.0" />
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0" />
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <link name="lidar_l1_link">
    <inertial>
      <mass value="0.5" />
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/L1_4D_Lidar.dae" scale="1 1 1" />
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="../meshes/L1_4D_Lidar.dae" scale="1 1 1" />
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0" />
      </material>
    </collision>
  </link>
  <joint name="lidar_l1_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_l1_link" />
    <origin rpy="2.879 0.0 1.5705" xyz="0.25 -0.038 -0.03" />
  </joint>
  <!-- Frame of /utlidar/cloud, pose from Unitree's go2_l1_lidar.yaml -->
  <link name="utlidar_lidar" />
  <joint name="utlidar_lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="utlidar_lidar" />
    <origin rpy="0 2.88 0" xyz="0.28216 0 -0.02467" />
  </joint>
  <!-- Frame of /utlidar/imu, Unitree's rotate_yaw_bias from the cloud frame, not its imu2lidar -->
  <link name="utlidar_imu" />
  <joint name="utlidar_imu_joint" type="fixed">
    <parent link="utlidar_lidar" />
    <child link="utlidar_imu" />
